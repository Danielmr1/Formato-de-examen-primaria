rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Cada docente solo puede leer y escribir su propio perfil y sus propios exámenes
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /exams/{examId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

